+#ifdef TARGET_PC
+// Mod: the LEVEL HEIGHT slider (platform/gx/src/gx_mod_slider.cpp). The
+// level's models are drawn scaled vertically by port_world_scale_y; collision
+// is unchanged. port_world_scale_dirty counts down a few frames after a change.
+extern "C" float port_world_scale_y;
+extern "C" int port_world_scale_dirty;
+#endif
