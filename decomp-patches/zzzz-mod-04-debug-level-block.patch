+		snprintf(name, sizeof name, "%s.bmd", od->unk0);
+	char path[128];
+	snprintf(path, sizeof path, "%s/%s", keeper->getModelDataKeeper()->getFolder(), name);
+	void* res = JKRGetResource(path);
+	if (res == nullptr) {
+		OSReport("debug block: no model %s\n", path);
+		return;
+	}
+	J3DModelData* data = J3DModelLoaderDataBase::load(res, keeper->mModelLoaderFlags);
+	J3DTexture* tex    = data != nullptr ? data->getTexture() : nullptr;
+	J3DTexture* texB   = b->getModel()->getModelData()->getTexture();
+	if (tex == nullptr || texB == nullptr || tex->getNum() == 0) {
+		OSReport("debug block: model %s has no textures\n", path);
+		return;
+	}
+
+	// the letter: the first texture whose texels differ from B's
+	int letter = -1;
+	for (u16 i = 0; i < tex->getNum() && i < texB->getNum() && letter < 0; ++i) {
+		const ResTIMG* ta = tex->getResTIMG(i);
+		const ResTIMG* tb = texB->getResTIMG(i);
+		if (ta->width != tb->width || ta->height != tb->height || ta->format != tb->format) {
+			letter = i;
+			break;
+		}
+		u32 bytes = GXGetTexBufferSize(ta->width, ta->height, ta->format, GX_FALSE, 1);
+		if (memcmp((const u8*)ta + ta->imageDataOffset, (const u8*)tb + tb->imageDataOffset,
+		           bytes) != 0)
+			letter = i;
+	}
+	if (letter < 0) {
+		OSReport("debug block: no letter texture found\n");
+		return;
+	}
+
+	// One block, header table first, so every image offset stays positive:
+	// copies of the other textures' images and palettes, then the D.
+	const u16 num = tex->getNum();
+	const ResTIMG* lt = tex->getResTIMG(letter);
+	u16 w = lt->width, h = lt->height;
+	u32 total = 0x20 * num;
+	for (u16 i = 0; i < num; ++i) {
+		const ResTIMG* t = tex->getResTIMG(i);
+		if (i == letter)
+			total += ((u32)w * h * 2 + 31) & ~31u;
+		else
+			total += portTexBytes(t) + (((u32)t->numColors * 2 + 31) & ~31u);
+	}
+	u8* blk = new (0x20) u8[total];
+	if (blk == nullptr)
+		return;
+	ResTIMG* hdr = (ResTIMG*)blk;
+	u32 at       = 0x20 * num;
+	for (u16 i = 0; i < num; ++i) {
+		const ResTIMG* t = tex->getResTIMG(i);
+		hdr[i]           = *t;
+		u8* self         = (u8*)&hdr[i];
+		if (i == letter) {
+			ResTIMG& n       = hdr[i];
+			n.format         = GX_TF_RGB5A3;
+			n.alphaEnabled   = 0;
+			n.isIndexTexture = 0;
+			n.colorFormat    = 0;
+			n.numColors      = 0;
+			n.paletteOffset  = 0;
+			n.mipmapEnabled  = 0;
+			n.mipmapCount    = 1;
+			n.minLod         = 0;
+			n.maxLod         = 0;
+			n.minFilter      = GX_LINEAR;
+			n.magFilter      = GX_LINEAR;
+			n.imageDataOffset = (u32)(blk + at - self);
+			// 4 x 4 tiles, rows of tiles, each tile row-major
+			u8* out = blk + at;
+			for (int ty = 0; ty < h; ty += 4)
+				for (int tx = 0; tx < w; tx += 4)
+					for (int y = ty; y < ty + 4; ++y)
+						for (int x = tx; x < tx + 4; ++x) {
+							u16 c  = portDTexel(x, y, w, h);
+							*out++ = (u8)(c >> 8);
+							*out++ = (u8)c;
+						}
+			at += ((u32)w * h * 2 + 31) & ~31u;
+		} else {
+			u32 bytes = portTexBytes(t);
+			memcpy(blk + at, (const u8*)t + t->imageDataOffset, bytes);
+			hdr[i].imageDataOffset = (u32)(blk + at - self);
+			at += bytes;
+			if (t->numColors != 0) {
+				u32 pb = (u32)t->numColors * 2;
+				memcpy(blk + at, (const u8*)t + t->paletteOffset, pb);
+				hdr[i].paletteOffset = (u32)(blk + at - self);
+				at += (pb + 31) & ~31u;
+			}
+		}
+	}
+	data->setTexture(new J3DTexture(num, hdr));
+
+	// the D block draws this model from now on
+	u32 flags       = d->getSDLModelFlag();
+	SDLModel* model = new SDLModel(new SDLModelData(data), flags, 1);
+	d->getMActor()->setModel(model, flags);
+	d->getMActor()->calc();
+	s_portFaceTextured = true;
+	OSReport("debug block: own model %s, texture %d of %d is the D (%dx%d)\n", path, letter,
+	         num, w, h);
+}
