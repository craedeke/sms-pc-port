+f32 portGetBE32(const u8* p)
+{
+	u32 v = ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3];
+	f32 f;
+	memcpy(&f, &v, 4);
