+};
+
+void portFaceVertex(const f32 c[3], const f32 r[3], const f32 u[3], f32 a,
+                    f32 b, u8 cr, u8 cg, u8 cb)
+{
+	GXPosition3f32(c[0] + r[0] * a + u[0] * b, c[1] + r[1] * a + u[1] * b,
+	               c[2] + r[2] * a + u[2] * b);
+	GXColor4u8(cr, cg, cb, 0xff);
+}
+
+void portFaceQuad(const f32 c[3], const f32 r[3], const f32 u[3], f32 a0,
+                  f32 b0, f32 a1, f32 b1, u8 cr, u8 cg, u8 cb)
+{
+	portFaceVertex(c, r, u, a0, b0, cr, cg, cb);
+	portFaceVertex(c, r, u, a1, b0, cr, cg, cb);
+	portFaceVertex(c, r, u, a1, b1, cr, cg, cb);
+	portFaceVertex(c, r, u, a0, b1, cr, cg, cb);
+}
+
