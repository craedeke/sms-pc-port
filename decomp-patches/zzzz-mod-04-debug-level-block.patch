+// the scene file's are.
+int portFileBlockIndex(const u8* body, s32 size, s32* posOffset)
+{
+	static const char* const names[3] = { "ロードブロックＡ", "ロードブロックＢ",
+		                                  "ロードブロックＣ" };
+	if (size < 4)
+		return -1;
+	s32 len = (body[2] << 8) | body[3];
+	if (4 + len + 12 > size)
+		return -1;
+	*posOffset = 4 + len;
+	for (int i = 0; i < 3; ++i)
+		if ((s32)strlen(names[i]) == len && memcmp(body + 4, names[i], len) == 0)
+			return i;
+	return -1;
