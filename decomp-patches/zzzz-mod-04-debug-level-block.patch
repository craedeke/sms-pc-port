+static bool port_debug_menu_update(TCardLoad* p)
+{
+	if (!s_portDebugMenuOpen) {
+		if (!port_debug_menu_request)
+			return false;
+		port_debug_menu_request = 0;
+		if (p->unk14 != 0 || p->unk10 != 2)
