+static void port_debug_text(JUTFont* font, int sizeX, int sizeY,
+                            const JUTRect& box, const char* text,
+                            JUtility::TColor top, JUtility::TColor bottom)
+{
+	// (font, colour, colour) and getSize are empty in the decomp's J2DPrint:
+	// this constructor and getWidth are the implemented ones
+	J2DPrint print(font, 0, -0x80000000, top, bottom);
+	print.setFontSize(sizeX, sizeY);
+	f32 width = print.getWidth("%s", text);
+	int x = box.x1 + (int)((box.getWidth() - width) * 0.5f);
+	int y = box.y1 + (int)((box.getHeight() + sizeY * 0.75f) * 0.5f);
+	print.print(x, y, "%s", text);
+}
