 // 234 bytes of .rodata order.
 #include <Map/MapCollisionEntry.hpp>
 
+#ifdef TARGET_PC
+#include <stdlib.h>
+#include <string.h>
+#include <JSystem/JSupport/JSUMemoryInputStream.hpp>
+
+// Mod: a fourth file block, right of C, that loads file A into the whitebox
+// test level (CardLoad.cpp, Map.cpp). It is a copy of block A's scene entry placed as far
+// right of C as C is right of B, made when C loads and added to C's group.
+extern "C" int port_debug_level_requested;
+int port_debug_level_requested = 0;
+
+namespace {
+
+u8* s_portBlockABody     = nullptr; // block A's entry, from its name on
+s32 s_portBlockABodySize = 0;
+JGeometry::TVec3<f32> s_portBlockBPos;
+bool s_portHaveBlockBPos = false;
+TFileLoadBlock* s_portDebugBlock     = nullptr;
+JDrama::TNameRef* s_portDebugAfter   = nullptr;
+bool s_portMakingDebugBlock          = false;
+
+void portPutBE32(u8* p, f32 value)
+{
+	u32 v;
+	memcpy(&v, &value, 4);
+	p[0] = (u8)(v >> 24);
+	p[1] = (u8)(v >> 16);
+	p[2] = (u8)(v >> 8);
+	p[3] = (u8)v;
+}
+
+} // namespace
+
+extern "C" JDrama::TNameRef* port_take_extra_scene_child(JDrama::TNameRef* loaded)
+{
+	if (loaded == nullptr || loaded != s_portDebugAfter)
+		return nullptr;
+	s_portDebugAfter = nullptr;
+	return s_portDebugBlock;
+}
+
+void TFileLoadBlock::load(JSUMemoryInputStream& stream)
+{
+	const u8* body = (const u8*)stream.mBuffer + stream.mPosition;
+	const s32 size = stream.mLength - stream.mPosition;
+
+	TMapObjBase::load(stream);
+
+	if (s_portMakingDebugBlock)
+		return;
+
+	if (unk138 == 0) {
+		// a new file-select scene: keep A's entry for the copy
+		free(s_portBlockABody);
+		s_portBlockABody     = (u8*)malloc(size);
+		s_portBlockABodySize = s_portBlockABody ? size : 0;
+		if (s_portBlockABody)
+			memcpy(s_portBlockABody, body, size);
+		s_portHaveBlockBPos = false;
+		s_portDebugBlock    = nullptr;
+		s_portDebugAfter = nullptr;
+		return;
+	}
+
+	if (unk138 == 1) {
+		s_portBlockBPos     = mPosition;
+		s_portHaveBlockBPos = true;
+		return;
+	}
+
+	if (unk138 != 2 || !s_portHaveBlockBPos || s_portBlockABody == nullptr
+	    || s_portBlockABodySize < 4)
+		return;
+
+	// The entry starts with the key (u16) and name (u16 length + bytes), then
+	// the position as three big-endian floats.
+	const u8* a     = s_portBlockABody;
+	s32 nameLen     = (a[2] << 8) | a[3];
+	s32 posOffset   = 4 + nameLen;
+	if (posOffset + 12 > s_portBlockABodySize)
+		return;
+
+	u8* copy = (u8*)malloc(s_portBlockABodySize);
+	if (copy == nullptr)
+		return;
+	memcpy(copy, s_portBlockABody, s_portBlockABodySize);
+	// as far right of C as C is right of B
+	portPutBE32(copy + posOffset + 0, mPosition.x * 2.0f - s_portBlockBPos.x);
+	portPutBE32(copy + posOffset + 4, mPosition.y * 2.0f - s_portBlockBPos.y);
+	portPutBE32(copy + posOffset + 8, mPosition.z * 2.0f - s_portBlockBPos.z);
+
+	TFileLoadBlock* block = new TFileLoadBlock;
+	JSUMemoryInputStream copyStream(copy, s_portBlockABodySize);
+	s_portMakingDebugBlock = true;
+	block->load(copyStream);
+	s_portMakingDebugBlock = false;
+	// copy stays allocated: a few bytes, once per file-select scene
+
+	s_portDebugBlock = block;
+	s_portDebugAfter = this;
+}
+#endif
