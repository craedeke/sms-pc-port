+
+void TFileLoadBlock::perform(u32 cue, JDrama::TGraphics* graphics)
+{
+	TMapObjBase::perform(cue, graphics);
+	if (this != s_portDebugBlock || getModel() == nullptr)
+		return;
+	if (cue & CUE_MOVE)
+		portDebugBlockHeadCheck(this);
+	if (!(cue & CUE_DRAW) || s_portFaceTextured)
+		return; // the overlay is only a fallback for a missing texture
+
+	f32 lo[3], hi[3];
+	portBlockBox(this, lo, hi);
+	f32 mid[3] = { (lo[0] + hi[0]) * 0.5f, (lo[1] + hi[1]) * 0.5f,
+		           (lo[2] + hi[2]) * 0.5f };
+
+	// The camera, from the view matrix: -R^T t.
+	MtxPtr v = j3dSys.getViewMtx();
+	f32 cam[3];
+	for (int i = 0; i < 3; ++i)
+		cam[i] = -(v[0][i] * v[0][3] + v[1][i] * v[1][3] + v[2][i] * v[2][3]);
+
+	// The side facing the camera: X or Z, whichever it is more in front of.
+	f32 dx = (cam[0] - mid[0]) / (hi[0] - lo[0] + 1.0f);
+	f32 dz = (cam[2] - mid[2]) / (hi[2] - lo[2] + 1.0f);
+	f32 n[3] = { 0, 0, 0 };
+	f32 halfW, halfH = (hi[1] - lo[1]) * 0.5f;
+	f32 c[3] = { mid[0], mid[1], mid[2] };
+	if ((dx < 0 ? -dx : dx) > (dz < 0 ? -dz : dz)) {
+		n[0] = dx > 0 ? 1.0f : -1.0f;
+		c[0] = (n[0] > 0 ? hi[0] : lo[0]) + n[0] * 1.5f;
+		halfW = (hi[2] - lo[2]) * 0.5f;
+	} else {
+		n[2] = dz > 0 ? 1.0f : -1.0f;
+		c[2] = (n[2] > 0 ? hi[2] : lo[2]) + n[2] * 1.5f;
+		halfW = (hi[0] - lo[0]) * 0.5f;
+	}
+	// seen from outside, right = -n x up
+	f32 u[3] = { 0, 1, 0 };
+	f32 r[3] = { n[2], 0, -n[0] };
+
+	GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_POS, GX_POS_XYZ, GX_F32, 0);
+	GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_CLR0, GX_CLR_RGBA, GX_RGBA8, 0);
+	GXClearVtxDesc();
+	GXSetVtxDesc(GX_VA_POS, GX_DIRECT);
+	GXSetVtxDesc(GX_VA_CLR0, GX_DIRECT);
+	GXLoadPosMtxImm(v, GX_PNMTX0);
+	GXSetCurrentMtx(GX_PNMTX0);
+	GXSetNumChans(1);
+	GXSetChanCtrl(GX_COLOR0A0, GX_FALSE, GX_SRC_REG, GX_SRC_VTX, 0, GX_DF_NONE,
+	              GX_AF_NONE);
+	GXSetNumTexGens(0);
+	GXSetNumIndStages(0);
+	GXSetNumTevStages(1);
+	GXSetTevDirect(GX_TEVSTAGE0);
+	GXSetTevOrder(GX_TEVSTAGE0, GX_TEXCOORD_NULL, GX_TEXMAP_NULL, GX_COLOR0A0);
+	GXSetTevOp(GX_TEVSTAGE0, GX_PASSCLR);
+	GXSetBlendMode(GX_BM_NONE, GX_BL_ONE, GX_BL_ZERO, GX_LO_NOOP);
+	GXSetAlphaCompare(GX_ALWAYS, 0, GX_AOP_AND, GX_ALWAYS, 0);
+	GXSetZCompLoc(GX_TRUE);
+	GXSetZMode(GX_TRUE, GX_LEQUAL, GX_TRUE);
+	GXSetCullMode(GX_CULL_NONE);
+
+	// a purple panel over the letter, a white "D" on it
+	int lit = 0;
+	for (int row = 0; row < 7; ++row)
+		for (int col = 0; col < 5; ++col)
+			lit += kPortGlyphD[row][col] == '1';
+	GXBegin(GX_QUADS, GX_VTXFMT0, (u16)(4 + lit * 4));
+	const f32 inset = 0.92f;
+	portFaceQuad(c, r, u, -halfW * inset, -halfH * inset, halfW * inset,
+	             halfH * inset, 0x5a, 0x2a, 0x9a);
+	const f32 cell = halfH * inset * 2.0f / 9.0f; // 7 rows plus a margin
+	// in front of the panel by a hair
+	f32 c2[3] = { c[0] + n[0] * 0.8f, c[1], c[2] + n[2] * 0.8f };
+	for (int row = 0; row < 7; ++row)
+		for (int col = 0; col < 5; ++col) {
+			if (kPortGlyphD[row][col] != '1')
+				continue;
+			f32 a0 = (col - 2.5f) * cell, b0 = (3.5f - row - 1) * cell;
+			portFaceQuad(c2, r, u, a0, b0, a0 + cell, b0 + cell, 0xff, 0xff,
+			             0xff);
+		}
+	GXEnd();
+}
