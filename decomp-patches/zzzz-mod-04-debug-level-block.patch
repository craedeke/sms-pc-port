+namespace {
+
+void portFaceVertex(const f32 c[3], const f32 r[3], const f32 u[3], f32 a,
+                    f32 b, u8 cr, u8 cg, u8 cb)
+{
+	GXPosition3f32(c[0] + r[0] * a + u[0] * b, c[1] + r[1] * a + u[1] * b,
+	               c[2] + r[2] * a + u[2] * b);
+	GXColor4u8(cr, cg, cb, 0xff);
+}
+
+void portFaceQuad(const f32 c[3], const f32 r[3], const f32 u[3], f32 a0,
+                  f32 b0, f32 a1, f32 b1, u8 cr, u8 cg, u8 cb)
+{
+	portFaceVertex(c, r, u, a0, b0, cr, cg, cb);
+	portFaceVertex(c, r, u, a1, b0, cr, cg, cb);
+	portFaceVertex(c, r, u, a1, b1, cr, cg, cb);
+	portFaceVertex(c, r, u, a0, b1, cr, cg, cb);
+}
+
+// The block's box in the world, from its root joint.
+void portBlockBox(TFileLoadBlock* b, f32 lo[3], f32 hi[3])
+{
+	J3DJoint* root = b->getModel()->getModelData()->getJointNodePointer(0);
+	Vec mn = root->getMin(), mx = root->getMax();
+	if (mx.x - mn.x < 1.0f || mx.y - mn.y < 1.0f || mx.z - mn.z < 1.0f) {
+		mn.x = mn.z = -50.0f;
+		mn.y = 0.0f;
+		mx.x = mx.z = 50.0f;
+		mx.y = 100.0f;
+	}
+	const JGeometry::TVec3<f32>& p = b->mPosition;
+	const JGeometry::TVec3<f32>& k = b->mScaling;
+	lo[0] = p.x + mn.x * k.x;
+	lo[1] = p.y + mn.y * k.y;
+	lo[2] = p.z + mn.z * k.z;
+	hi[0] = p.x + mx.x * k.x;
+	hi[1] = p.y + mx.y * k.y;
+	hi[2] = p.z + mx.z * k.z;
+}
+
+f32 s_portPrevMarioY  = 0.0f;
+bool s_portPrevMarioOk = false;
+int s_portHeadCooldown = 0;
+
+// A backup for the game's own hit: Mario rising into the underside of the
+// block, judged from his position. Logs what it sees once a second while he
+// is under the block.
+void portDebugBlockHeadCheck(TFileLoadBlock* b)
+{
+	if (gpMarioPos == nullptr)
+		return;
+	if (s_portHeadCooldown > 0)
+		--s_portHeadCooldown;
+	f32 lo[3], hi[3];
+	portBlockBox(b, lo, hi);
+	const JGeometry::TVec3<f32>& m = *gpMarioPos;
+	bool under = m.x > lo[0] - 30.0f && m.x < hi[0] + 30.0f && m.z > lo[2] - 30.0f
+	          && m.z < hi[2] + 30.0f && m.y < lo[1];
+	bool rising = s_portPrevMarioOk && m.y > s_portPrevMarioY + 1.0f;
+	s_portPrevMarioY  = m.y;
+	s_portPrevMarioOk = true;
+	static int logTick = 0;
+	if (under && ++logTick % 60 == 0)
+		OSReport("debug block: Mario under it at y %.0f, block bottom %.0f, "
+		         "state %d\n", m.y, lo[1], (int)b->mState);
+	// his head is about 160 above his feet
+	if (under && rising && m.y + 200.0f > lo[1] && s_portHeadCooldown == 0) {
+		s_portHeadCooldown = 60;
+		OSReport("debug block: head hit (backup check)\n");
+		port_debug_menu_request = 1;
+	}
+}
