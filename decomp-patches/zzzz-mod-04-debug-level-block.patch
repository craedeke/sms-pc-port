+} // namespace
+
+// The file blocks load A, B, C in turn. A and B wait for C: then all three
+// are laid out again -- moved left by 15% of the A-C span and closed up so
+// that a fourth, the D block (a copy of A), stands where C was.
+void TFileLoadBlock::load(JSUMemoryInputStream& stream)
+{
+	const u8* body = (const u8*)stream.mBuffer + stream.mPosition;
+	const s32 size = stream.mLength - stream.mPosition;
+
+	if (s_portMakingDebugBlock) {
+		TMapObjBase::load(stream);
+		return;
+	}
+
+	s32 posOffset = 0;
+	int idx       = portFileBlockIndex(body, size, &posOffset);
+	if (idx == 0 || idx == 1) {
+		if (idx == 0) {
+			portFlushPending(); // a new scene
+			s_portDebugBlock = nullptr;
+			s_portDebugAfter = nullptr;
+		}
+		PortPendingBlock& p = s_portPending[idx];
+		free(p.body);
+		p.body = (u8*)malloc(size);
+		if (p.body == nullptr) {
+			p.block = nullptr;
+			TMapObjBase::load(stream);
+			return;
+		}
+		memcpy(p.body, body, size);
+		p.size      = size;
+		p.posOffset = posOffset;
+		p.block     = this;
+		return; // loaded with C
+	}
+	if (idx != 2 || s_portPending[0].block == nullptr || s_portPending[1].block == nullptr) {
+		portFlushPending();
+		TMapObjBase::load(stream);
+		return;
+	}
+
+	PortPendingBlock& pa = s_portPending[0];
+	PortPendingBlock& pb = s_portPending[1];
+	JGeometry::TVec3<f32> a0 = portBodyPos(pa.body, pa.posOffset);
+	JGeometry::TVec3<f32> c0 = portBodyPos(body, posOffset);
+	JGeometry::TVec3<f32> span(c0.x - a0.x, c0.y - a0.y, c0.z - a0.z);
+	JGeometry::TVec3<f32> a1(a0.x - span.x * 0.15f, a0.y - span.y * 0.15f,
+	                         a0.z - span.z * 0.15f);
+	JGeometry::TVec3<f32> step((c0.x - a1.x) / 3.0f, (c0.y - a1.y) / 3.0f,
+	                           (c0.z - a1.z) / 3.0f);
+	JGeometry::TVec3<f32> b1(a1.x + step.x, a1.y + step.y, a1.z + step.z);
+	JGeometry::TVec3<f32> c1(a1.x + step.x * 2, a1.y + step.y * 2, a1.z + step.z * 2);
+
+	TFileLoadBlock* blockA = pa.block;
+	TFileLoadBlock* blockB = pb.block;
+	portLoadAt(blockA, pa.body, pa.size, pa.posOffset, a1);
+	portLoadAt(blockB, pb.body, pb.size, pb.posOffset, b1);
+	portLoadAt(this, body, size, posOffset, c1);
+
+	// the D block, from A's entry, where C was
+	TFileLoadBlock* block = new TFileLoadBlock;
+	portLoadAt(block, pa.body, pa.size, pa.posOffset, c0);
+	portGiveDebugBlockItsTexture(block, blockB);
+
+	for (int i = 0; i < 2; ++i) {
+		free(s_portPending[i].body);
+		s_portPending[i].body  = nullptr;
+		s_portPending[i].block = nullptr;
+	}
+	s_portDebugBlock = block;
+	s_portDebugAfter = this;
+}
