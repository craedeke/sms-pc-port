+// on screen: each block's panes move by its block's share.
+static void port_shift_file_panes(TCardLoad* p)
+{
+	f32 x[3];
+	for (int i = 0; i < 3; ++i) {
+		if (p->unk2A4[i] == nullptr)
+			return;
+		const JUTRect& r = p->unk2A4[i]->mInitialBounds;
+		x[i]             = (r.x1 + r.x2) * 0.5f;
+	}
+	f32 a1   = x[0] - (x[2] - x[0]) * 0.15f;
+	f32 step = (x[2] - a1) / 3.0f;
+	for (int i = 0; i < 3; ++i) {
+		int dx = (int)(a1 + step * i - x[i] + (a1 + step * i - x[i] < 0 ? -0.5f : 0.5f));
+		if (dx == 0)
+			continue;
+		J2DPane* label = p->unk2A4[i]->getPane();
+		J2DPane* menu  = p->unk33C[i] != nullptr ? p->unk33C[i]->getPane() : nullptr;
+		port_shift_expane(p->unk2A4[i], dx);
+		// the menu box and its items, unless they sit inside a pane that moved
+		if (menu != nullptr && !port_pane_inside(menu, label))
+			port_shift_expane(p->unk33C[i], dx);
+		for (int j = 0; j < 4; ++j) {
+			TExPane* item = p->unk378[i][j];
+			if (item == nullptr || item->getPane() == nullptr)
+				continue;
+			if (!port_pane_inside(item->getPane(), label)
+			    && !port_pane_inside(item->getPane(), menu))
+				port_shift_expane(item, dx);
