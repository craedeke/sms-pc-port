+		SMSGetMSound()->startSoundSystemSE(MSD_SE_SY_COIN_APPEAR, 0, nullptr,
+		                                   0);
+		return true;
+	}
+
+	TMarioGamePad* pad = p->unk38;
+	if (pad->checkFrameMeaning(0x4) || pad->checkFrameMeaning(0x2)) {
+		s_portDebugMenuCursor ^= 1;
+		SMSGetMSound()->startSoundSystemSE(MSD_SE_SY_SELECT_COMMON, 0, nullptr,
+		                                   0);
+	} else if (pad->checkFrameMeaning(0x20)) {
+		if (s_portDebugMenuCursor == 0) {
+			// SANDBOX: a fresh game, sent to the whitebox level
+			SMSGetMSound()->startSoundSystemSE(MSD_SE_SY_DECIDE_COMMON, 0,
