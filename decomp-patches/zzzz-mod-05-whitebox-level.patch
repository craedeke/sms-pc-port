+// Mod: the whitebox test level. The debug block on the file-select screen
+// (MapObjOption.cpp / CardLoad.cpp) loads the test11 stage; there the stage's
+// own terrain is hidden (MapModel.cpp) and its collision replaced by simple
+// shapes built here -- a checker floor, stairs, ramps, walls, a wall-kick
+// corridor, ledges and a hill -- every one of them drawn and solid, from the
+// same triangles. Other actors are switched off (Strategy.cpp).
+extern "C" int port_debug_level_stage;
+extern "C" int port_debug_level_scenario;
+
+extern "C" int port_in_debug_level()
+{
+	return port_debug_level_stage >= 0
+	    && gpApplication.mCurrArea.getStage() == (u8)port_debug_level_stage
+	    && gpApplication.mCurrArea.getScenario()
+	           == (u8)port_debug_level_scenario;
